<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Model Performance - Diabetes Predictor</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

  <style>
    body { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Inter", sans-serif; }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Navbar -->
  <nav class="bg-white shadow-lg border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center">
          <div class="gradient-bg p-2 rounded-lg">
            <i class="fas fa-heartbeat text-white text-xl"></i>
          </div>
          <span class="ml-3 text-xl font-bold text-gray-800">Diabetes Predictor</span>
        </div>
        <div class="hidden md:flex space-x-4">
          <a href="/" class="px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-100 font-medium">
            <i class="fas fa-home mr-2"></i>Dashboard
          </a>
          <a href="/batch" class="px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-100 font-medium">
            <i class="fas fa-file-upload mr-2"></i>Batch Prediction
          </a>
          <a href="/risk-simulator" class="px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-100 font-medium">
            <i class="fas fa-sliders-h mr-2"></i>Risk Simulator
          </a>
          <a href="/model-performance" class="px-4 py-2 rounded-lg bg-indigo-50 text-indigo-700 font-semibold">
            <i class="fas fa-chart-line mr-2"></i>Model Performance
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Model Performance</h1>
      <p class="text-gray-600">
        Monitor how the diabetes risk model performs and decide when retraining is needed.
      </p>
    </header>

    <!-- Metric cards -->
    <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-2xl shadow-lg p-5 border border-gray-200">
        <p class="text-xs font-semibold text-gray-500 uppercase">Accuracy</p>
        <p id="accuracyValue" class="mt-2 text-3xl font-extrabold text-indigo-600">–</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-5 border border-gray-200">
        <p class="text-xs font-semibold text-gray-500 uppercase">Precision</p>
        <p id="precisionValue" class="mt-2 text-3xl font-extrabold text-indigo-600">–</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-5 border border-gray-200">
        <p class="text-xs font-semibold text-gray-500 uppercase">Recall</p>
        <p id="recallValue" class="mt-2 text-3xl font-extrabold text-indigo-600">–</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg p-5 border border-gray-200">
        <p class="text-xs font-semibold text-gray-500 uppercase">F1 Score</p>
        <p id="f1Value" class="mt-2 text-3xl font-extrabold text-indigo-600">–</p>
      </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Confusion matrix -->
      <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-200">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Confusion Matrix</h2>
        <p class="text-xs text-gray-500 mb-4">
          Binary classification: Positive = diabetes present, Negative = no diabetes.
        </p>
        <div class="grid grid-cols-3 gap-2 text-xs text-gray-800">
          <div></div>
          <div class="text-center font-semibold">Pred: Negative</div>
          <div class="text-center font-semibold">Pred: Positive</div>

          <div class="font-semibold flex items-center">Actual: Negative</div>
          <div id="cmTN" class="text-center bg-green-50 border border-green-200 rounded-lg py-3 font-mono">0</div>
          <div id="cmFP" class="text-center bg-red-50 border border-red-200 rounded-lg py-3 font-mono">0</div>

          <div class="font-semibold flex items-center">Actual: Positive</div>
          <div id="cmFN" class="text-center bg-red-50 border border-red-200 rounded-lg py-3 font-mono">0</div>
          <div id="cmTP" class="text-center bg-green-50 border border-green-200 rounded-lg py-3 font-mono">0</div>
        </div>
      </div>

      <!-- Retraining info -->
      <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-200">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Retraining Workflow</h2>
        <p class="text-sm text-gray-700 mb-3">
          Upload new labeled datasets and trigger retraining from the admin API endpoint (/api/retrain).
        </p>
        <ul class="list-disc list-inside text-sm text-gray-700 space-y-2">
          <li>Collect new patient outcomes over time and add them to a CSV with the same schema as training data.</li>
          <li>Call the retrain endpoint to fit an updated model and refresh these metrics.</li>
          <li>Monitor drops in recall, precision, or overall accuracy as triggers for retraining.</li>
        </ul>
      </div>
    </section>
  </main>

  <script>
    async function loadMetrics() {
      try {
        const res = await fetch("/api/metrics");
        if (!res.ok) {
          console.error("Failed to load metrics");
          return;
        }
        const m = await res.json();

        if (typeof m.accuracy === "number") {
          document.getElementById("accuracyValue").textContent = (m.accuracy * 100).toFixed(1) + "%";
        }
        if (typeof m.precision === "number") {
          document.getElementById("precisionValue").textContent = (m.precision * 100).toFixed(1) + "%";
        }
        if (typeof m.recall === "number") {
          document.getElementById("recallValue").textContent = (m.recall * 100).toFixed(1) + "%";
        }
        if (typeof m.f1 === "number") {
          document.getElementById("f1Value").textContent = (m.f1 * 100).toFixed(1) + "%";
        }

        const cm = Array.isArray(m.confusion_matrix) ? m.confusion_matrix : [[0, 0], [0, 0]];
        const TN = cm[0]?.[0] ?? 0;
        const FP = cm[0]?.[1] ?? 0;
        const FN = cm[1]?.[0] ?? 0;
        const TP = cm[1]?.[1] ?? 0;

        document.getElementById("cmTN").textContent = TN;
        document.getElementById("cmFP").textContent = FP;
        document.getElementById("cmFN").textContent = FN;
        document.getElementById("cmTP").textContent = TP;
      } catch (e) {
        console.error("Error loading metrics", e);
      }
    }

    document.addEventListener("DOMContentLoaded", loadMetrics);
  </script>
</body>
</html>
